{
  "name": "dsh-subagent-codex",
  "version": "0.1.2",
  "description": "DSH subagent provider that delegates tasks to the OpenAI Codex CLI (codex exec), exposing the subagent_codex tool",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjylfz/dsh-subagent-codex.git"
  },
  "bugs": {
    "url": "https://github.com/mjylfz/dsh-subagent-codex/issues"
  },
  "homepage": "https://github.com/mjylfz/dsh-subagent-codex#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "subagent",
    "codex",
    "openai"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-subagent": "^0.1.0-rc.7 || >=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.0"
  }
}
